# Copy to /etc/ringabot/ringabot.env (mode 0600). Fill values on the host only.
# Never commit filled values. Use your own xAI key, not one from another agent.

# Your xAI API key (server side only).
XAI_API_KEY=
# Standard Webhooks secret (whsec_...). `ringabot register-number` writes it here.
XAI_WEBHOOK_SECRET=
# Admin bearer for /call and /calls, and for MCP when you are the operator (32+ chars).
# Generate with: openssl rand -hex 32
API_TOKEN=

# Your carrier number in E.164 or 10 digits. Calls to any other number are refused.
DID=
# Public https base URL that Caddy serves, e.g. https://203-0-113-7.sslip.io
PUBLIC_URL=
# Comma-separated carrier SIP signaling CIDRs allowed to send INVITEs to xAI.
SIP_ALLOWED_CIDRS=

# Listener (keep on loopback; Caddy terminates TLS).
HOST=
PORT=

# Persona for every call, inbound and outbound. Defaults: name Ringabot, voice aurora,
# notes "Be brief and polite.". GREETING is the opening line
# (default "Hi, this is <PERSONA_NAME>, an AI assistant."); keep it short, say it is an AI.
PERSONA_NAME=
VOICE=
INSTRUCTIONS=
GREETING=

# Limits. Defaults: 600 s max call, 30 s of silence, 2 concurrent calls, 20 kept in memory.
MAX_CALL_SECONDS=
IDLE_TIMEOUT=
MAX_CONCURRENT_CALLS=

# Outbound calls (baresip dials through your carrier). Sub-account user and password,
# and carrier POP hostname.
SIP_SERVER=
SIP_USERNAME=
SIP_PASSWORD=
# Any valid number may be called except emergency, N11, premium-rate and invalid numbers.
# ALLOWED_DESTINATIONS is an optional extra restriction (comma-separated E.164 prefixes);
# RINGABOT_BLOCKED_DESTINATIONS adds prefixes that must never be dialed.
ALLOWED_DESTINATIONS=
RINGABOT_BLOCKED_DESTINATIONS=
# Calls one caller identity may start per hour and per day (defaults 10 and 30, 0 = no limit).
RINGABOT_RATE_LIMIT_PER_HOUR=
RINGABOT_RATE_LIMIT_PER_DAY=
# 0 turns off the send_dtmf tool (keypad digits for phone menus on outbound calls).
RINGABOT_DTMF_ENABLED=

# sqlite file for call records, rate limits and client state. Empty uses /var/lib/ringabot/ringabot.sqlite.
RINGABOT_DB=

# Longest call briefing kept, in characters (default 12000, max 60000). xAI documents no limit
# for session instructions; this keeps the voice model quick. Longer briefings are cut at a
# heading/paragraph boundary and the place_call result says so.
RINGABOT_MAX_BRIEFING_CHARS=
# Post-call summary/todos/decisions come from this xAI text model (default grok-4-1-fast-non-reasoning).
RINGABOT_SUMMARY_MODEL=
# Optional end-of-call webhook (place_call callback_url): shared secret for the
# X-Ringabot-Signature HMAC header, and 1 to allow http://localhost callbacks (tests only).
RINGABOT_CALLBACK_SECRET=
# Transcript and briefing text of calls older than this many days is deleted (default 30, 0 keeps
# forever). Summaries, todos, decisions and outcomes are kept. Checked at startup and every 6 hours.
RINGABOT_TRANSCRIPT_RETENTION_DAYS=
RINGABOT_CALLBACK_ALLOW_LOCALHOST=

# Lookups during outbound calls: the agent gets a get_context tool (build_status, inbox,
# ticket). build_status reads the GitHub API (GITHUB_TOKEN only for a private repo). The
# other topics are answered from what the bot put in the briefing or add_context.
RINGABOT_CONTEXT_ENABLED=
CONTEXT_GITHUB_REPO=
GITHUB_TOKEN=
# Optional, normally unset: a feed that answers topics itself (examples/context_feed.py).
RINGABOT_CONTEXT_FEED_URL=
RINGABOT_CONTEXT_FEED_TOKEN=

# Optional plugins: comma-separated module:factory entries (see README). Empty loads none.
RINGABOT_PLUGINS=
