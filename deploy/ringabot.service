[Unit]
Description=Ringabot xAI SIP webhook listener
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ringabot
Group=ringabot
SupplementaryGroups=audio
EnvironmentFile=/etc/ringabot/ringabot.env
WorkingDirectory=/opt/ringabot
RuntimeDirectory=ringabot
StateDirectory=ringabot
ExecStartPre=-+/sbin/modprobe snd-aloop
ExecStart=/opt/ringabot/.venv/bin/ringabot serve
Restart=on-failure
RestartSec=2
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectKernelModules=true
CapabilityBoundingSet=
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
MemoryMax=300M
LimitNOFILE=4096
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
